# Скопируйте этот файл в .env и при необходимости поменяйте значения.
# Файл .env в git не попадает.

POSTGRES_DB=vols
POSTGRES_USER=vols
POSTGRES_PASSWORD=vols

# Секрет для токенов входа. На сервере компании — обязательно длинная случайная строка.
SECRET_KEY=change-me-in-production

ENVIRONMENT=dev

# Мониторинг узлов доступа:
#   simulate — имитация статусов (ноутбук, нет доступа к сети узлов)
#   ping     — реальный опрос (сервер компании)
#   off      — выключен
MONITORING_MODE=simulate

APP_PORT=8000
DB_PORT=5432
