# Скопируйте этот файл в .env и при необходимости поменяйте значения.
# Файл .env в git не попадает.

POSTGRES_DB=vols
POSTGRES_USER=vols
POSTGRES_PASSWORD=vols

# Секрет для токенов входа. На сервере компании — обязательно длинная случайная строка.
SECRET_KEY=dev-only-secret-change-me-on-server-0123456789

ENVIRONMENT=dev

# Мониторинг узлов доступа:
#   simulate — имитация статусов (ноутбук, нет доступа к сети узлов)
#   ping     — реальный опрос (сервер компании)
#   off      — выключен
MONITORING_MODE=simulate

APP_PORT=8000
# Порт базы на компьютере (для DBeaver/pgAdmin). 5432 часто занят своим PostgreSQL.
DB_HOST_PORT=5433

# Вход с телефона (этап 10): адрес ноутбука/сервера в Wi-Fi-сети — на него выпускается
# HTTPS-сертификат. На ноутбуке его записывает phone.bat; на сервере укажите IP или имя сервера.
PHONE_HOST=
HTTPS_PORT=8443
